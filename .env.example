# Copy to .env and fill in real values. .env is gitignored.
# `make config` renders these into config.yaml for the containers.

# --- Secrets ---
# GitHub token — raises cvelistV5 API rate limits (optional)
GH_TOKEN=
# NVD API key — reserved for enrichment endpoints (optional)
NVD_API_KEY=

# --- Core app overrides (optional; sensible container defaults exist) ---
# CVE_DATA_DIR=/app/data
# CVE_UPLOAD_DIR=/app/uploads
# CVE_DB_PATH=/app/db/analytics.db
# CVE_LOG_LEVEL=INFO
# CVE_DEBUG=false
# CVE_GITHUB_MAX_CVE_FILES=10
# CVE_REGISTRY_HOST=registry.local:5000

# --- RAG module (optional) ---
# RAG_LLM_BASE_URL=http://localhost:1234/v1
# RAG_LLM_MODEL=local-model
# RAG_LLM_TIMEOUT=300
# RAG_TOP_K=8
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
